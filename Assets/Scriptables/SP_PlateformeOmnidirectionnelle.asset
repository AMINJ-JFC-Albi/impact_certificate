  conceptualDesignSpecificationTitle: "SPECIFICACI\xD3N DEL DISE\xD1O DE CONCEPTO:"
  productName: Plataforma omnidireccional (Omnidirectional Treadmill)
  productDescriptionTitle: "Descripci\xF3n general "
  productDescription: "Dispositivos que permiten al usuario caminar f\xEDsicamente
    mientras permanece est\xE1tico, con la retranscripci\xF3n de los desplazamientos
    en realidad virtual.\r\nEjemplos: Virtuix Omni, Kat Walk"
  keyUtilityFunctionsTitle: Funciones utilitarias
  keyUtilityFunctions: "- Desplazamiento natural dentro del entorno virtual\r\n-
    Simulaci\xF3n de la marcha o la carrera\r\n- Reducci\xF3n de los desplazamientos
    virtuales artificiales"
  pedagogicalAspectsTitle: "Aspectos pedag\xF3gicos"
  pedagogicalAspects: "- Aprendizaje espacial y contextual\r\n- Realismo de los desplazamientos\r\n-
    Mejor comprensi\xF3n de entornos complejos\r\n- Entrenamiento en escenarios din\xE1micos"
  productPicture: {fileID: 21300000, guid: 305938f4d8c7f834d81e4c52ad02c0fe, type: 3}
  pedagogicalUsesTitle: "Tipos de usos pedag\xF3gicos"
  pedagogicalUses: "- Ejercicios de evacuaci\xF3n\r\n- Formaci\xF3n militar o de
    seguridad civil\r\n- Exploraci\xF3n de sitios o edificios\r\n- Simulaciones urbanas"
  pedagogicalAdvantagesTitle: "Ventajas pedag\xF3gicas"
  pedagogicalAdvantages: "- Inmersi\xF3n f\xEDsica reforzada\r\n- Reducci\xF3n del
    motion sickness\r\n- Compromiso corporal total"
  usageLimitsTitle: Limitaciones de uso
  usageLimits: '- Equipamiento voluminoso

    - Alto costo

    - Necesidad de
    aprendizaje del equilibrio'
