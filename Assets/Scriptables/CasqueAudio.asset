  conceptualDesignSpecificationTitle: 'SPECIFICATION DU DESIGN DE CONCEPT:'
  productName: "Casques audio spatialis\xE9s (Audio 3D) "
  productDescriptionTitle: "Description g\xE9n\xE9rale"
  productDescription: "Syst\xE8mes audio capables de reproduire un son positionnel
    en trois dimensions, synchronis\xE9 avec l\u2019environnement virtuel.\r\n"
  keyUtilityFunctionsTitle: Fonctions utilitaires
  keyUtilityFunctions: "- Restitution sonore r\xE9aliste\r\n- Localisation des sources
    sonores\r\n- Ambiance immersive"
  pedagogicalAspectsTitle: "Aspects p\xE9dagogiques"
  pedagogicalAspects: "- Apprentissage par l\u2019\xE9coute active\r\n- D\xE9veloppement
    de la perception spatiale\r\n- Renforcement du r\xE9alisme des sc\xE9narios\r\n-
    Aide \xE0 la prise de d\xE9cision en contexte"
  productPicture: {fileID: 21300000, guid: 90cc71d5d8bbe3b4cb4ceef7fc76ff48, type: 3}
  pedagogicalUsesTitle: "Types d\u2019usages p\xE9dagogiques"
  pedagogicalUses: "- Formation s\xE9curit\xE9 (d\xE9tection de dangers)\r\n- Simulations
    de crise\r\n- Apprentissage linguistique immersif\r\n- Formation militaire ou
    a\xE9ronautique"
  pedagogicalAdvantagesTitle: "Avantages p\xE9dagogiques "
  pedagogicalAdvantages: "- Immersion accrue \xE0 faible co\xFBt\r\n- Compl\xE9ment
    essentiel \xE0 l\u2019image\r\n- Peu intrusif pour l\u2019utilisateur"
  usageLimitsTitle: Limitations d'usages
  usageLimits: "- Moins impactant seul sans VR visuelle\r\n- D\xE9pend fortement
    de la qualit\xE9 du mix audio"
