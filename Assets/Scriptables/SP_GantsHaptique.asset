  conceptualDesignSpecificationTitle: "SPECIFICACI\xD3N DEL DISE\xD1O DE CONCEPTO:"
  productName: "Guantes h\xE1pticos (Haptic Gloves)"
  productDescriptionTitle: "Descripci\xF3n general "
  productDescription: "Guantes equipados con sensores y sistemas de retroalimentaci\xF3n
    de fuerza que permiten sentir sensaciones t\xE1ctiles dentro del entorno virtual.\r\nEjemplos:
    HaptX, Manus VR, SenseGlove"
  keyUtilityFunctionsTitle: Funciones utilitarias
  keyUtilityFunctions: "- Simulaci\xF3n del tacto\r\n- Retroalimentaci\xF3n de fuerza
    y resistencia\r\n- Seguimiento preciso de los dedos"
  pedagogicalAspectsTitle: "Aspectos pedag\xF3gicos"
  pedagogicalAspects: "- Aprendizaje sensoriomotor avanzado\r\n- Comprensi\xF3n f\xEDsica
    de los objetos y materiales\r\n- Entrenamiento de gestos finos y precisos\r\n-
    Enfoque realista de las competencias manuales"
  productPicture: {fileID: 21300000, guid: f93e76dc99c2bb64bab039b318164eb3, type: 3}
  pedagogicalUsesTitle: "Tipos de usos pedag\xF3gicos"
  pedagogicalUses: "- Formaci\xF3n m\xE9dica y quir\xFArgica\r\n- Mantenimiento industrial\r\n-
    Artesan\xEDa y oficios t\xE9cnicos\r\n- Rehabilitaci\xF3n y fisioterapia"
  pedagogicalAdvantagesTitle: "Ventajas pedag\xF3gicas"
  pedagogicalAdvantages: "- Alto realismo\r\n- Transferencia m\xE1s eficaz al mundo
    real\r\n- Mejora de la precisi\xF3n gestual"
  usageLimitsTitle: Limitaciones de uso
  usageLimits: "- Alto costo\r\n- Implementaci\xF3n t\xE9cnica compleja\r\n- Poco
    adecuado para un uso de gran p\xFAblico"
